OPENROUTER_API_KEY=""
GROQ_API_KEY=""

# "openrouter" (default) or "groq" — selects which OpenAI-compatible endpoint
# app/agent/llm.py talks to. MODEL is interpreted relative to whichever
# provider is active.
LLM_PROVIDER="openrouter"
MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"

# PRD v2 change 2 — human-in-the-loop reviewer email. Use a Gmail address +
# an App Password (not your account password): https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
FROM_EMAIL=""

# Reviewer inboxes, routed by decision type. For a demo these can all point
# to the same address.
OPS_REVIEWER_EMAIL=""
FINANCE_REVIEWER_EMAIL=""
SENIOR_ANALYST_EMAIL=""

# Base URL used to build the [Approve] [Reject] [Request more info] links
# embedded in reviewer emails.
BACKEND_PUBLIC_URL="http://localhost:8000"
